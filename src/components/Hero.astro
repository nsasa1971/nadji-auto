---
interface Props {
  /** Putanja do fotografije (npr. /hero/hero.jpg). Bez nje se prikazuje tamna pozadina. */
  slika?: string;
  alt?: string;
}
const { slika, alt = '' } = Astro.props;
---
<section class="hero">
  {slika ? (
    <img class="pozadina" src={slika} alt={alt} fetchpriority="high" decoding="async" />
  ) : (
    <div class="rezerva" aria-hidden="true"></div>
  )}
  <div class="preklop" aria-hidden="true"></div>
  <div class="kontejner sadrzaj">
    <h1>Pronađi auto kojem <span>možeš da veruješ.</span></h1>
    <p>Besplatni oglasi za polovne automobile u Srbiji, sa oznakom za vozila koja imaju priložen izveštaj o pregledu.</p>
  </div>
  <!-- Faza 3: panel pretrage koji se preklapa sa dnom herojа -->
</section>
<style>
  .hero { position: relative; isolation: isolate; background: var(--tamna); color: var(--tekst-na-tamnom); min-height: 420px; display: flex; align-items: center; padding-block: var(--razmak-8); overflow: hidden; }
  .pozadina { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  /* Rezervno mesto za fotografiju dok je nemamo */
  .rezerva { position: absolute; inset: 0; z-index: -2; background: linear-gradient(135deg, #10151c 0%, #1a222d 100%); }
  .preklop { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, rgb(16 21 28 / 0.9) 0%, rgb(16 21 28 / 0.65) 55%, rgb(16 21 28 / 0.35) 100%),
    linear-gradient(0deg, rgb(16 21 28 / 0.7) 0%, transparent 40%); }
  .sadrzaj { max-width: var(--kontejner); }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); max-width: 18ch; }
  h1 span { color: var(--akcent); }
  p { font-size: 1.125rem; max-width: 46ch; color: var(--tekst-sek-na-tamnom); margin: var(--razmak-4) 0 0; }
</style>
