---
import '../styles/global.css';
import { SITE_URL } from 'astro:env/server';

interface Props { naslov?: string; opis?: string }
const { naslov, opis = 'Besplatan oglasnik za prodaju automobila u Srbiji.' } = Astro.props;
const puniNaslov = naslov ? `${naslov} | Nađi auto` : 'Nađi auto — oglasnik za automobile';
const NOINDEX = true; // vrati na false pri lansiranju
const kanonski = new URL(Astro.url.pathname, SITE_URL).toString();
---
<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{puniNaslov}</title>
    <meta name="description" content={opis} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={kanonski} />
  </head>
  <body>
    <slot />
  </body>
</html>
